# 项目根目录（默认自动推断）
EVERRAG_ROOT=

# LLM（默认 mock；设为 deepseek 并按需设置 DEEPSEEK_API_KEY 启用 LLMComposer）
LLM_PROVIDER=mock
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
DEEPSEEK_API_KEY=
LLM_TEMPERATURE=0.2

# 检索后端（bm25 | memory；memory 为内存词法检索 fallback）
RETRIEVAL_BACKEND=bm25

# 基础设施（阶段 2 使用；MVP 默认内存后端）
MILVUS_URI=http://localhost:19530
REDIS_URL=redis://localhost:6379/0
MYSQL_DSN=mysql://root:everrag@localhost:3306/everrag

# 危机干预热线
CRISIS_HOTLINE=12356
